{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OnlyHeatmaps BR26",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/onlyheatmaps.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--url",
        "https://www.sofascore.com/football/tournament/brazil/brasileirao-serie-a/325#id:87678",
        "--csv",
        "BR26_defensive.csv",
        "--output-dir",
        "./HeatmapsBR26",
        "--resume",
